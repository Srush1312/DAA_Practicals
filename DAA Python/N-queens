N = 8

board = [[0 for j in range(N)] for i in range(N)]


def is_safe(row, col):
    for i in range(row):
        if board[i][col] == 1:
            return False

    i = row - 1
    j = col - 1

    while i >= 0 and j >= 0:
        if board[i][j] == 1:
            return False
        i -= 1
        j -= 1

    i = row - 1
    j = col + 1

    while i >= 0 and j < N:
        if board[i][j] == 1:
            return False
        i -= 1
        j += 1

    return True


def solve_queens(row):
    if row == N:
        return True

    for col in range(N):
        if is_safe(row, col):
            board[row][col] = 1

            if solve_queens(row + 1):
                return True

            board[row][col] = 0

    return False


first_row = int(input("Enter first queen row (0-7): "))
first_col = int(input("Enter first queen column (0-7): "))

if 0 <= first_row < N and 0 <= first_col < N:
    board[first_row][first_col] = 1

    if solve_queens(first_row + 1):
        print("Solution:")
        for row in board:
            print(row)
    else:
        print("No solution exists for this position.")
else:
    print("Invalid position")
